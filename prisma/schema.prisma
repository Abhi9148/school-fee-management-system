// School Fee Management System — Prisma Schema
// Run: npx prisma migrate dev --name init

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

model Class {
  id            String         @id @default(cuid())
  name          String         // e.g. "Grade 5 - A"
  students      Student[]
  feeStructures FeeStructure[]
  createdAt     DateTime       @default(now())
}

model Student {
  id             String        @id @default(cuid())
  name           String
  admissionNo    String        @unique
  classId        String
  class          Class         @relation(fields: [classId], references: [id])
  parentName     String
  parentContact  String
  status         StudentStatus @default(ACTIVE)
  invoices       Invoice[]
  createdAt      DateTime      @default(now())
}

model FeeStructure {
  id        String     @id @default(cuid())
  classId   String
  class     Class      @relation(fields: [classId], references: [id])
  term      String     // e.g. "Term 1", "Annual"
  dueDate   DateTime
  feeHeads  FeeHead[]
  invoices  Invoice[]
  createdAt DateTime   @default(now())
}

model FeeHead {
  id             String       @id @default(cuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id])
  name           String       // e.g. "Tuition Fee", "Transport Fee"
  amount         Float
}

model Invoice {
  id                String        @id @default(cuid())
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id])
  feeStructureId    String
  feeStructure      FeeStructure  @relation(fields: [feeStructureId], references: [id])
  totalAmount       Float
  concessionAmount  Float         @default(0)
  amountPaid        Float         @default(0)
  lateFeeApplied    Float         @default(0)
  status            InvoiceStatus @default(UNPAID)
  dueDate           DateTime
  payments          Payment[]
  createdAt         DateTime      @default(now())
}

model Payment {
  id            String      @id @default(cuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentDate   DateTime    @default(now())
  mode          PaymentMode
  lateFeeApplied Float      @default(0)
  receiptNo     String      @unique
  createdAt     DateTime    @default(now())
}
